{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile and status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "nickName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "banUntil": { "type": "string" },
        "isPermanentlyBanned": { "type": "boolean" },
        "reportCount": { "type": "number" },
        "blockedUsers": { "type": "array" }
      },
      "required": ["uid", "email", "username", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fromUid", "toUid", "status", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat session between participants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "lastMessage": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message sent inside a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderUid": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "chatId", "senderUid", "text", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User report for violations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reportedUid": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "reporterUid", "reportedUid", "reason", "createdAt"]
    },
    "AppStats": {
      "title": "AppStats",
      "description": "Aggregated application stats",
      "type": "object",
      "properties": {
        "usersCount": { "type": "number" },
        "messagesCount": { "type": "number" },
        "countriesCount": { "type": "number" },
        "uptime": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["usersCount", "messagesCount"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Admin and staff member account details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["super", "admin", "staff", "moderator"] },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles and accounts"
    },
    "/friend_requests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Stores friend requests"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Stores conversation metadata"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores messages in a conversation"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Stores abuse reports"
    },
    "/stats/{statId}": {
      "schema": { "$ref": "#/entities/AppStats" },
      "description": "Stores application statistics"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Stores staff and admin accounts"
    }
  }
}
